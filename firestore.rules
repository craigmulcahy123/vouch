rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authenticated dashboard users manage their own data ───────────────────
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public recording page: anyone with the link can read campaign details ─
    // Anonymous sign-in is used on the recording page so request.auth != null.
    match /users/{userId}/campaigns/{campaignId} {
      allow read: if request.auth != null;
    }

    // ── Public recording page: clients submit testimonials (no account needed) ─
    match /users/{userId}/testimonials/{testimonialId} {
      allow write: if request.auth != null;
      // ── Public profile page: anyone can read approved testimonials ───────────
      // This powers the /profile/{userId} page without exposing private data.
      allow read: if resource.data.status == "approved";
    }

    // ── Invite status updates from the recording page ─────────────────────────
    match /users/{userId}/invites/{inviteId} {
      allow update: if request.auth != null;
    }

    // ── Partner applications — anyone can submit, no client-side reads ────────
    // Reads are handled server-side via Admin SDK only.
    match /partners/{partnerId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
