{
  "rewrites": [
    { "source": "/record/(.*)", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/profile/(.*)", "destination": "/profile.html" },
    { "source": "/success/a2z-cloud", "destination": "/success/a2z-cloud.html" },
    { "source": "/directory", "destination": "/directory.html" },
    { "source": "/badge-preview", "destination": "/badge-preview.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/gdpr", "destination": "/gdpr.html" },
    { "source": "/partners", "destination": "/partners.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
