rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logo images — owner writes, anyone can read (needed for public profile pages)
    match /logos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Testimonial recordings — any authenticated user (incl. anonymous) can read/write
    match /testimonials/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

  }
}
